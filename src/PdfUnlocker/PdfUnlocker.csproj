<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window flashes when launched from Explorer (Open With / Send To).
         Flip to Exe for easier terminal debugging; diagnostics go to PdfUnlocker.log either way. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 6.2.0+ required: adds revision-5 (AES-256) decryption support. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfUnlocker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the sample config next to the exe so it can be copied to PdfUnlocker.config. -->
    <None Include="..\..\PdfUnlocker.config.sample" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
